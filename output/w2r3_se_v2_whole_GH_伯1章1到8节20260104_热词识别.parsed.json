      "title": "宣告宣读本周正道经文为约伯记一章1至8节，难解之处将尽力解释"
    },
    {
      "no": "3",
      "start": 9,
      "end": 24,
      "title": "诵读约伯记一章1至8节：约伯完全正直、家产丰厚，神的众子与撒但侍立耶和华面前"
    },
    {
      "no": "4",
      "start": 25,
      "end": 33,
      "title": "谢恩祷告：求神开通众弟兄姊妹的耳朵，赏赐古旧信仰的真信心与得救的知识"
    },
    {
      "no": "5",
      "start": 34,
      "end": 48,
      "title": "全篇分两部分讲解：1至5节约伯的现实背景，6至8节约伯被耶和华认可的属灵背景"
    },
    {
      "no": "6",
      "start": 49,
      "end": 54,
      "title": "自我介绍与服侍任务：抛开传统把先知使徒的福音传给会众，作这里敬拜的根基"
    },
    {
      "no": "7",
      "start": 55,
      "end": 63,
      "title": "今日教会多关注个人今生的祸福而非国度，故借约伯记消除旧观念，为领受真道作预备"
    },
    {
      "no": "8",
      "start": 64,
      "end": 67,
      "title": "约伯记是智慧书第一卷，其大主题并非苦难而是认识耶和华的智慧"
    },
    {
      "no": "9",
      "start": 68,
      "end": 79,
      "title": "全篇讨论两个问题：世上是否存在绝对的平安；上帝认可的信仰是否意味着远离灾祸"
    },
    {
      "no": "10",
      "start": 80,
      "end": 87,
      "title": "约伯记成书极早，可能早于创世记，约伯是比亚伯拉罕更早的古代圣徒"
    },
    {
      "no": "11",
      "start": 88,
      "end": 114,
      "title": "约伯是乌斯地人而非以色列人；耶和华是全地全人类的主，麦基洗德与巴兰都认识他"
    },
    {
      "no": "12",
      "start": 115,
      "end": 153,
      "title": "约伯记开篇1至5节要交代约伯的稳固，与后文家破人亡的处境形成落差；读时不要先开启上帝视角"
    },
    {
      "no": "13",
      "start": 154,
      "end": 174,
      "title": "人生动荡与困境的风险因素、家庭的抗风险能力，以及遇灾祸即恶有恶报的通常看法"
    },
    {
      "no": "14",
      "start": 175,
      "end": 214,
      "title": "约伯记一章1节：约伯完全正直、敬畏神远离恶事，道德、司法与信仰上的风险全被排除"
    },
    {
      "no": "15",
      "start": 215,
      "end": 224,
      "title": "除虔诚外还要看硬实力：人丁兴旺、儿子多意味着家族势力大，是抗风险的保障"
    },
    {
      "no": "16",
      "start": 225,
      "end": 228,
      "title": "约伯记一章2节：约伯生七个儿子三个女儿，人丁兴旺是家庭抗风险的第二把锁"
    },
    {
      "no": "17",
      "start": 229,
      "end": 267,
      "title": "约伯记一章3节：七千羊、三千骆驼、五百对牛与母驴并许多仆婢，牧业、物流与田产规模极其庞大"
    },
    {
      "no": "18",
      "start": 268,
      "end": 280,
      "title": "约伯在东方的国际地位为至大，其强盛连一个城邦的君王都难以做到"
    },
    {
      "no": "19",
      "start": 281,
      "end": 303,
      "title": "总结约伯：经济富可敌国、地位东方为至大，从道德、信仰到硬实力都看不出任何风险"
    },
    {
      "no": "20",
      "start": 304,
      "end": 323,
      "title": "回应豪门争产的质疑：约伯记一章4节显示其儿女常在一处聚餐，家庭其乐融融"
    },
    {
      "no": "21",
      "start": 324,
      "end": 353,
      "title": "约伯记一章5节：约伯宴席后叫儿女自洁、按数目献燔祭，对家庭的信仰守望是顶配"
    },
    {
      "no": "22",
      "start": 354,
      "end": 363,
      "title": "约伯记的冲击：如此稳固的家竟家破人亡，允许此事的正是他们全家敬畏的耶和华"
    },
    {
      "no": "23",
      "start": 364,
      "end": 384,
      "title": "约伯记位列智慧书第一卷，读懂它就会倒掉一切基督教的毒鸡汤与虚假的平安"
    },
    {
      "no": "24",
      "start": 385,
      "end": 410,
      "title": "人对自己人生稳健度的评估标准终将失效，一切抗风险的支架都可能瞬间倒塌"
    },
    {
      "no": "25",
      "start": 411,
      "end": 427,
      "title": "身外之物与皮骨都失去后，剩下的只有敬畏耶和华所积累的真知识与真智慧"
    },
    {
      "no": "26",
      "start": 428,
      "end": 444,
      "title": "要在约伯记起头就预备好：错误的期待带来错误的信心，唯有持守纯正、不更改福音"
    },
    {
      "no": "27",
      "start": 445,
      "end": 476,
      "title": "以约伯记二章9节“从神手里得福，也从神手里受祸”回应信耶稣必保平安的说法"
    },
    {
      "no": "28",
      "start": 477,
      "end": 511,
      "title": "罗马书万事互相效力为救恩得益处：为永恒不可废去之福，甘愿接受今生的福与祸"
    },
    {
      "no": "29",
      "start": 512,
      "end": 546,
      "title": "两套截然不同的福音：上帝只赐福不降祸，还是上帝以福祸同为儿女的救恩效力"
    },
    {
      "no": "30",
      "start": 547,
      "end": 556,
      "title": "约伯记一章1至5节总结：一切抗风险的稳固支架都不算数，唯有耶和华的篱笆与敬畏神的智慧"
    },
    {
      "no": "31",
      "start": 557,
      "end": 571,
      "title": "第二部分开场：把镜头切到天上，天上的属灵场景才是影响家庭与历史的关键"
    },
    {
      "no": "32",
      "start": 572,
      "end": 604,
      "title": "约伯记一章6节：神的众子聚集在耶和华面前，撒但也来在其中，暗示他已不在其列"
    },
    {
      "no": "33",
      "start": 605,
      "end": 646,
      "title": "约伯记一章7节：耶和华主动问撒但从哪里来，是给撒但说话的授权而非搭讪找茬"
    },
    {
      "no": "34",
      "start": 647,
      "end": 660,
      "title": "撒但的一切行动都在耶和华权柄的限制之下，信徒因此在困境中仍能安稳"
    },
    {
      "no": "35",
      "start": 661,
      "end": 677,
      "title": "约伯记一章8节：耶和华主动称赞约伯，是否等于引魔鬼攻击义人——两个选择题"
    },
    {
      "no": "36",
      "start": 678,
      "end": 710,
      "title": "魔鬼不全知、不全能、也不全在，受空间限制，唯有耶和华全知全能全在"
    },
    {
      "no": "37",
      "start": 711,
      "end": 730,
      "title": "撒但因受空间限制须走来走去，故常年在约伯身边观察他，本身就想试探他"
    },
    {
      "no": "38",
      "start": 731,
      "end": 775,
      "title": "撒但两次对约伯的评估都落空，耶和华从起初就全然认识约伯，评价毫无差错"
    },
    {
      "no": "39",
      "start": 776,
      "end": 793,
      "title": "耶和华两次允许约伯受重祸令人费解；义人受苦、恶人亨通是圣经反复出现的主题"
    },
    {
      "no": "40",
      "start": 794,
      "end": 813,
      "title": "各宗教都以灵验顺遂为招牌，福音却是不可废去之福，乞丐拉撒路至死未得回"
    },
    {
      "no": "41",
      "start": 814,
      "end": 850,
      "title": "好人不长命、王八活千年：不可因遭灾就怀疑信仰，也不可因顺遂就认可信仰"
    },
    {
      "no": "42",
      "start": 851,
      "end": 889,
      "title": "举例说明随私意解读环境：赴会前腿摔断，有人说上帝拦阻，有人说撒但拦阻"
    },
    {
      "no": "43",
      "start": 890,
      "end": 923,
      "title": "不要做替人解读处境的属灵懂王；天上的场景非人的智慧可及，唯有智慧书的智慧如干净皮袋可盛新酒"
    },
    {
      "no": "44",
      "start": 924,
      "end": 942,
      "title": "结尾问答：顺遂与否不是第一鉴别标准，上帝六十六卷圣言才是；最大灾祸是心眼昏迷"
    },
    {
      "no": "45",
      "start": 943,
      "end": 967,
      "title": "约翰福音九章1至3节：门徒以罪限定答案，耶稣说这人生来瞎眼是要显出神的作为"
    },
    {
      "no": "46",
      "start": 968,
      "end": 969,
      "title": "结束祷告：求神照着祂的话带领会众开始查考约伯记"
    }
