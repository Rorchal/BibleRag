{
  "doc_summary": "约伯记二章讲属灵征战实为持守纯正，上帝护理涵盖祸福。",
  "chapters": [
    {
      "title": "属灵征战与上帝护理",
      "summary": "本章通过约伯记二章1-6节，讲解属灵征战的实质是持守纯正，并阐述上帝护理的整全教义。",
      "sections": [
        {
          "title": "属灵征战的真实方式",
          "summary": "约伯得胜非靠特殊手段，而是持守纯正，上帝在撒旦面前见证。",
          "paragraphs": [
            {
              "start": 1,
              "end": 14,
              "summary": "讲员诵读约伯记二章1-5节，描述神众子侍立、撒旦也在其中，神问撒旦是否查看约伯，撒旦要求伤约伯骨肉。",
              "keywords": ["约伯记", "撒旦", "神众子"]
            },
            {
              "start": 15,
              "end": 31,
              "summary": "讲员祷告后，说明分两方面讲：1-3节属灵征战，4-6节肉体灾难的属灵源头。",
              "keywords": ["祷告", "属灵征战", "肉体灾难"]
            },
            {
              "start": 32,
              "end": 46,
              "summary": "讲员提出两个话题：全副军装和上帝护理，并回顾约伯从东方自大变为次身之人。",
              "keywords": ["全副军装", "上帝护理", "约伯"]
            },
            {
              "start": 47,
              "end": 61,
              "summary": "讲员强调约伯虽失去身外物和身内物，但敬畏耶和华仍被保留。",
              "keywords": ["约伯", "敬畏", "身外物"]
            },
            {
              "start": 62,
              "end": 76,
              "summary": "讲员指出约伯的信仰告白证明财富地位不是敬畏缘由，并解释神的众子是天使。",
              "keywords": ["约伯", "信仰告白", "天使"]
            },
            {
              "start": 77,
              "end": 91,
              "summary": "讲员引用希伯来书说明天使是服役的灵，撒旦曾为其中一员但已堕落。",
              "keywords": ["希伯来书", "天使", "撒旦"]
            },
            {
              "start": 92,
              "end": 106,
              "summary": "讲员说明恶者非人死变异，而是堕落天使，撒旦从服役变为破坏救恩。",
              "keywords": ["堕落天使", "魔鬼", "救恩"]
            },
            {
              "start": 107,
              "end": 121,
              "summary": "讲员强调撒旦仍在上帝权柄下，上帝询问是授权，撒旦回答与第一轮相同。",
              "keywords": ["撒旦", "上帝权柄", "询问"]
            },
            {
              "start": 122,
              "end": 136,
              "summary": "讲员解释上帝询问非困惑而是授权，撒旦必须诚实交代，且受空间限制。",
              "keywords": ["上帝", "撒旦", "授权"]
            },
            {
              "start": 137,
              "end": 151,
              "summary": "讲员举例天使为以色列征战，但撒旦不在其中，且上帝在第三节多出对约伯得胜的描述。",
              "keywords": ["天使", "以色列", "约伯"]
            },
            {
              "start": 152,
              "end": 166,
              "summary": "讲员对比第一章和第二章第三节，上帝重复约伯正直，并新增约伯持守纯正的描述。",
              "keywords": ["约伯", "纯正", "上帝"]
            },
            {
              "start": 167,
              "end": 181,
              "summary": "讲员强调约伯从未与撒旦正面交锋，但通过信仰告白胜过第一轮攻击。",
              "keywords": ["约伯", "撒旦", "信仰告白"]
            },
            {
              "start": 182,
              "end": 196,
              "summary": "讲员指出约伯得胜方式非大声祷告，而是冷静宣告信仰，上帝以此见证。",
              "keywords": ["约伯", "得胜", "信仰宣告"]
            },
            {
              "start": 197,
              "end": 211,
              "summary": "讲员强调属灵征战实质是持守纯正，而非特殊手段，并指出魔鬼攻击是信息性的。",
              "keywords": ["属灵征战", "纯正", "魔鬼"]
            },
            {
              "start": 212,
              "end": 226,
              "summary": "讲员以伊甸园蛇攻击夏娃认知为例，说明魔鬼攻击目标是人对神的认识。",
              "keywords": ["伊甸园", "蛇", "认知"]
            },
            {
              "start": 227,
              "end": 241,
              "summary": "讲员强调魔鬼目的是使人不纯正而弃神，并引用保罗说我们晓得其轨迹。",
              "keywords": ["魔鬼", "纯正", "保罗"]
            },
            {
              "start": 242,
              "end": 256,
              "summary": "讲员以拉撒路复活为例，说明今世生命有限，基督徒盼望来世生命。",
              "keywords": ["拉撒路", "复活", "来世生命"]
            },
            {
              "start": 257,
              "end": 271,
              "summary": "讲员强调魔鬼知道纯正重要，攻击纯正，基督徒应优先守护纯正。",
              "keywords": ["魔鬼", "纯正", "守护"]
            },
            {
              "start": 272,
              "end": 286,
              "summary": "讲员引用约伯记中约伯的盼望，强调纯正不可杀，并提醒不要相信无人能纯正的谎言。",
              "keywords": ["约伯", "纯正", "盼望"]
            },
            {
              "start": 287,
              "end": 301,
              "summary": "讲员介绍以弗所书六章军装，强调军装抵挡魔鬼诡计，而非属血气。",
              "keywords": ["以弗所书", "军装", "魔鬼"]
            },
            {
              "start": 302,
              "end": 316,
              "summary": "讲员解释军装是抵挡诡计，而非刀剑，并指出人类无抵挡计谋的军装。",
              "keywords": ["军装", "诡计", "抵挡"]
            },
            {
              "start": 317,
              "end": 331,
              "summary": "讲员强调基督徒军装是支持性和策略性的，敌人是属灵气的恶魔。",
              "keywords": ["军装", "属灵气", "恶魔"]
            },
            {
              "start": 332,
              "end": 346,
              "summary": "讲员说明属灵气恶魔可造成实际磨难，但人无法上升维度攻击，只能站立。",
              "keywords": ["恶魔", "磨难", "站立"]
            },
            {
              "start": 347,
              "end": 361,
              "summary": "讲员强调撒旦降维打击，但基督徒可穿军装抵挡诡计，站立得稳。",
              "keywords": ["撒旦", "降维打击", "军装"]
            },
            {
              "start": 362,
              "end": 376,
              "summary": "讲员总结军装是知识性和策略性的，能抵挡诡计，使基督徒站立。",
              "keywords": ["军装", "知识", "站立"]
            },
            {
              "start": 377,
              "end": 391,
              "summary": "讲员引用以弗所书六章14-17节，说明军装核心是真理和道。",
              "keywords": ["以弗所书", "真理", "军装"]
            },
            {
              "start": 392,
              "end": 406,
              "summary": "讲员批评灵恩派斩龙聚会，强调圣灵的宝剑是神的道，而非实体剑。",
              "keywords": ["灵恩派", "圣灵的宝剑", "神的道"]
            },
            {
              "start": 407,
              "end": 421,
              "summary": "讲员解释军装各部分如公义、平安、信德等，都是真理的表现。",
              "keywords": ["公义", "平安", "信德"]
            },
            {
              "start": 422,
              "end": 436,
              "summary": "讲员强调整套军装共性是圣灵的道，能抵挡魔鬼计谋，产生品质。",
              "keywords": ["圣灵", "道", "军装"]
            },
            {
              "start": 437,
              "end": 451,
              "summary": "讲员回应军装是知识性的，但祷告仍必要，方向是讲明福音奥秘。",
              "keywords": ["祷告", "福音", "军装"]
            },
            {
              "start": 452,
              "end": 466,
              "summary": "讲员引用保罗要求为众圣徒和保罗放胆讲论祷告，强调勇气。",
              "keywords": ["保罗", "祷告", "放胆"]
            },
            {
              "start": 467,
              "end": 481,
              "summary": "讲员强调为教会讲台祷告，用真道抵御仇敌，约伯得胜方式一致。",
              "keywords": ["教会", "讲台", "真道"]
            },
            {
              "start": 482,
              "end": 496,
              "summary": "讲员总结1-3节，约伯持守纯正，上帝在撒旦面前见证。",
              "keywords": ["约伯", "纯正", "上帝"]
            }
          ]
        },
        {
          "title": "肉体苦难的属灵源头",
          "summary": "撒旦以皮代皮观察人类，约伯肉体苦难源于属灵恶魔，但上帝护理。",
          "paragraphs": [
            {
              "start": 497,
              "end": 511,
              "summary": "讲员指出撒旦第一轮观察约伯敬拜有缘故，第二轮观察全人类以皮代皮。",
              "keywords": ["撒旦", "以皮代皮", "人类"]
            },
            {
              "start": 512,
              "end": 526,
              "summary": "讲员解释以皮代皮是谚语，指不惜一切代价保命，撒旦认为人类如此。",
              "keywords": ["以皮代皮", "保命", "撒旦"]
            },
            {
              "start": 527,
              "end": 541,
              "summary": "讲员以拿命换钱、拿钱换命为例，说明撒旦对人类观察。",
              "keywords": ["拿命换钱", "拿钱换命", "人类"]
            },
            {
              "start": 542,
              "end": 556,
              "summary": "讲员强调撒旦认为约伯不能不在乎命，要求伤其骨肉，使其弃神。",
              "keywords": ["撒旦", "约伯", "骨肉"]
            },
            {
              "start": 557,
              "end": 571,
              "summary": "讲员指出撒旦认为约伯能不在乎家产，但不能不在乎身体，但上帝比身体重要。",
              "keywords": ["撒旦", "约伯", "身体"]
            },
            {
              "start": 572,
              "end": 586,
              "summary": "讲员强调敬畏上帝比肉体重要，因信身体复活和永生。",
              "keywords": ["敬畏", "身体", "永生"]
            },
            {
              "start": 587,
              "end": 601,
              "summary": "讲员指出上帝允许撒旦伤约伯但保留性命，导致约伯求死不能。",
              "keywords": ["上帝", "撒旦", "性命"]
            },
            {
              "start": 602,
              "end": 616,
              "summary": "讲员说明约伯因死不掉而痛苦，但上帝护理保留性命。",
              "keywords": ["约伯", "痛苦", "护理"]
            },
            {
              "start": 617,
              "end": 631,
              "summary": "讲员强调旁观者看上帝护理，但亲历者可能怀疑，因祸患也算护理。",
              "keywords": ["护理", "祸患", "怀疑"]
            },
            {
              "start": 632,
              "end": 646,
              "summary": "讲员指出现有秩序崩塌时，我们怀疑上帝护理，但护理包括祸患。",
              "keywords": ["护理", "秩序", "怀疑"]
            },
            {
              "start": 647,
              "end": 661,
              "summary": "讲员引用海德堡要理问答27问，护理包括荒年、贫穷、疾病等。",
              "keywords": ["海德堡要理问答", "护理", "荒年"]
            },
            {
              "start": 662,
              "end": 676,
              "summary": "讲员强调护理是整全的，包括顺境逆境，一切出于上帝之手。",
              "keywords": ["护理", "顺境", "逆境"]
            },
            {
              "start": 677,
              "end": 691,
              "summary": "讲员引用28问，护理的益处是患难中忍耐，顺境中感恩，万物不能隔绝爱。",
              "keywords": ["护理", "忍耐", "感恩"]
            },
            {
              "start": 692,
              "end": 706,
              "summary": "讲员指出约伯懂得护理教义，对妻子说从神得福也受祸。",
              "keywords": ["约伯", "护理", "妻子"]
            },
            {
              "start": 707,
              "end": 721,
              "summary": "讲员强调真正的信是相信上帝不变，而非环境不变，且意念正面。",
              "keywords": ["信", "上帝", "意念"]
            },
            {
              "start": 722,
              "end": 736,
              "summary": "讲员对比两套信仰，强调相信上帝不改变，失去一切也不失去应许。",
              "keywords": ["信仰", "上帝", "应许"]
            },
            {
              "start": 737,
              "end": 751,
              "summary": "讲员总结上帝保护我们，通过全副军装和护理，并推荐耶利米书29章。",
              "keywords": ["上帝", "军装", "耶利米书"]
            },
            {
              "start": 752,
              "end": 766,
              "summary": "讲员引用耶利米书29章，上帝意念是赐平安，不是降灾祸。",
              "keywords": ["耶利米书", "平安", "意念"]
            },
            {
              "start": 767,
              "end": 781,
              "summary": "讲员强调上帝平安的定义是末后有指望，并引用保罗托付以弗所长老。",
              "keywords": ["保罗", "以弗所", "指望"]
            },
            {
              "start": 782,
              "end": 795,
              "summary": "讲员以保罗交托圣道结束，勉励相信上帝意念，回到使徒之道。",
              "keywords": ["保罗", "圣道", "使徒"]
            }
          ]
        }
      ]
    }
  ]
}